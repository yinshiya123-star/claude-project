# DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本地语音识别模型：tiny / base / small / medium / large-v3
WHISPER_MODEL=small
# auto / cpu / cuda
WHISPER_DEVICE=auto

# 上传文件大小上限（MB）
MAX_UPLOAD_MB=500
