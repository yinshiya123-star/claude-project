# DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本地语音识别模型：tiny / base / small / medium / large-v3
WHISPER_MODEL=small
# cpu / cuda / auto（用显卡需另装 CUDA 12 和 cuDNN 9，出错会自动退回 CPU）
WHISPER_DEVICE=cpu

# 上传文件大小上限（MB），0 = 不限制
MAX_UPLOAD_MB=0
