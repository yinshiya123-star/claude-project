{
  "name": "木偶打光 · 默认流程",
  "version": 1,
  "description": "NV MAX 抠像/打光/后期 → Motion Ninja 运镜 → 保存相册。控件文字为中英文常见写法，坐标为 1080x2400 竖屏下的估计位置（比例），App 版本不同可能需要用录制模式校准。",
  "screen": { "width": 1080, "height": 2400 },
  "defaults": { "waitMs": 1200, "retries": 3, "findTimeoutMs": 2500, "verifyTimeoutMs": 6000 },

  "variables": {
    "keyTolerance": "0.30",
    "keyToleranceStep": "0.10",
    "previewX": "0.5",
    "previewY": "0.27",
    "characterOffsetY": "0.06",
    "lightSide": "1",
    "fillShift": "0.55",
    "greenHex": "00FF00",
    "blackHex": "000000",
    "nvTimelineY": "0.60",
    "nvSecWidth": "0.12",
    "mnTimelineY": "0.68",
    "mnSecWidth": "0.12",
    "pushZoom": "1.2",
    "pushOffsetX": "0.03",
    "pushOffsetY": "0.02"
  },

  "macros": {
    "addEffect": [
      { "action": "CLICK", "desc": "打开「添加效果」",
        "target": { "text": ["添加效果", "效果", "特效", "Add Effect", "Effects"], "desc": ["添加效果", "Add effect"], "x": 0.5, "y": 0.94 } },
      { "action": "CLICK", "desc": "点击搜索", "optional": true, "retries": 0,
        "target": { "text": ["搜索", "Search"], "desc": ["搜索", "Search"], "x": 0.5, "y": 0.11 } },
      { "action": "SET_TEXT", "desc": "输入「$[keyword]」", "text": "$[keyword]", "waitMs": 1500,
        "target": { "className": "EditText", "x": 0.5, "y": 0.11 } },
      { "action": "CLICK", "desc": "选择「$[item]」",
        "target": { "text": "$[item]", "exact": true, "x": 0.5, "y": 0.22 } }
    ],
    "addLayer": [
      { "action": "CLICK", "desc": "打开「添加图层」",
        "target": { "text": ["添加图层", "图层", "Add Layer", "Layer"], "desc": ["添加图层", "Add layer", "添加"], "x": 0.9, "y": 0.94 } },
      { "action": "CLICK", "desc": "选择「$[item]」",
        "target": { "text": "$[item]", "exact": true, "scroll": true, "x": 0.5, "y": 0.4 } }
    ],
    "duplicate": [
      { "action": "LONG_CLICK", "desc": "长按「$[name]」",
        "target": { "text": "$[name]", "sort": "x", "index": "$[index]", "x": "$[x]", "y": "$[y]" } },
      { "action": "CLICK", "desc": "复制",
        "target": { "text": ["复制", "Duplicate", "Copy"], "desc": ["复制", "Duplicate"], "exact": true, "x": 0.5, "y": 0.5 } }
    ],
    "setColor": [
      { "action": "CLICK", "desc": "打开「$[label]」取色器",
        "target": { "text": "$[label]", "x": 0.5, "y": 0.75 } },
      { "action": "SET_TEXT", "desc": "输入颜色 #$[hex]", "text": "$[hex]",
        "target": { "className": "EditText", "x": 0.5, "y": 0.62 } },
      { "action": "CLICK", "desc": "确定", "optional": true, "retries": 0,
        "target": { "text": ["确定", "完成", "OK", "Done"], "exact": true } }
    ],
    "keyframeHere": [
      { "action": "CLICK", "desc": "在当前时间打关键帧",
        "target": { "text": ["关键帧", "Keyframe"], "desc": ["关键帧", "添加关键帧", "Keyframe", "Add keyframe"], "x": 0.92, "y": 0.66 } }
    ],
    "nvSeek": [
      { "action": "TIMELINE_SEEK", "desc": "时间轴定位到 $[seconds] 秒", "seconds": "$[seconds]",
        "area": { "y": "${nvTimelineY}", "x1": 0.15, "x2": 0.85 }, "pxPerSecond": "${nvSecWidth}", "reset": true }
    ],
    "closePanel": [
      { "action": "CLICK", "desc": "关闭参数面板", "optional": true, "retries": 0,
        "target": { "text": ["完成", "Done", "✓"], "desc": ["完成", "关闭", "Done", "Close"], "exact": true } }
    ]
  },

  "steps": [
    { "phase": "准备素材", "id": "0.1", "action": "PREPARE_MEDIA",
      "desc": "把背景图和绿幕素材放进相册（绿幕=最新第1项，背景=第2项）" },

    { "phase": "第一步：NV MAX 准备素材", "id": "1.0", "action": "LAUNCH_APP", "desc": "打开 NV MAX",
      "package": "${nvmaxPackage}", "waitMs": 3500 },
    { "id": "1.1a", "action": "CLICK", "desc": "新建项目",
      "target": { "text": ["新建", "新项目", "创建项目", "New Project", "New"], "desc": ["新建", "新项目", "New project", "Create"], "x": 0.5, "y": 0.9 } },
    { "id": "1.1b", "action": "CLICK", "desc": "确认项目设置（默认比例）", "optional": true, "retries": 1,
      "target": { "text": ["创建", "确定", "Create", "OK"], "exact": true } },

    { "id": "1.1c", "action": "CLICK", "desc": "添加媒体（导入背景图）",
      "target": { "text": ["媒体", "导入", "Media", "Import"], "desc": ["添加媒体", "导入", "Add media", "Import"], "x": 0.1, "y": 0.94 } },
    { "id": "1.1d", "action": "CLICK", "desc": "选择相册第 2 项（背景图）",
      "target": { "desc": ["木偶背景"], "x": 0.5, "y": 0.2 } },
    { "id": "1.1e", "action": "CLICK", "desc": "确认导入", "optional": true, "retries": 1,
      "target": { "text": ["导入", "确定", "完成", "添加", "Import", "Done", "Add"], "exact": true, "x": 0.88, "y": 0.06 } },

    { "id": "1.1f", "action": "CLICK", "desc": "添加媒体（导入绿幕素材）",
      "target": { "text": ["媒体", "导入", "Media", "Import"], "desc": ["添加媒体", "导入", "Add media", "Import"], "x": 0.1, "y": 0.94 } },
    { "id": "1.1g", "action": "CLICK", "desc": "选择相册第 1 项（绿幕素材）",
      "target": { "desc": ["木偶角色"], "x": 0.17, "y": 0.2 } },
    { "id": "1.1h", "action": "CLICK", "desc": "确认导入", "optional": true, "retries": 1,
      "target": { "text": ["导入", "确定", "完成", "添加", "Import", "Done", "Add"], "exact": true, "x": 0.88, "y": 0.06 } },

    { "id": "1.2a", "action": "CLICK", "desc": "选中绿幕素材图层",
      "target": { "text": ["木偶角色"], "x": 0.3, "y": 0.72 } },
    { "id": "1.2b", "action": "MACRO", "name": "addEffect", "desc": "添加绿幕抠像",
      "args": { "keyword": "绿幕", "item": ["绿幕抠像", "色度抠像", "Chroma Key"] } },
    { "id": "1.2c", "action": "CLICK", "desc": "自动选取绿色（吸管）", "optional": true, "retries": 1,
      "target": { "text": ["吸管", "取色", "自动", "Pick"], "desc": ["吸管", "取色", "Color picker"] } },
    { "id": "1.2d", "action": "CLICK", "desc": "点击画面角落的绿色背景",
      "target": { "x": 0.12, "y": 0.12 } },
    { "id": "1.2e", "action": "SET_VALUE", "desc": "设置抠像容差", "value": "${keyTolerance}", "min": 0, "max": 1,
      "label": { "text": ["容差", "阈值", "Tolerance", "Threshold"] },
      "modes": ["field", "range", "slider"], "slider": { "x1": 0.35, "x2": 0.92 } },
    { "id": "1.2f", "action": "GREEN_CHECK", "desc": "截图检测是否残留绿色",
      "region": { "x1": 0.05, "y1": 0.08, "x2": 0.95, "y2": 0.45 },
      "threshold": 0.004, "maxAttempts": 4, "settleMs": 1500,
      "fixSteps": [
        { "action": "SET_VAR", "desc": "容差 +${keyToleranceStep}", "name": "keyTolerance",
          "value": "min(${keyTolerance} + ${keyToleranceStep}, 1)" },
        { "action": "SET_VALUE", "desc": "调高抠像容差", "value": "${keyTolerance}", "min": 0, "max": 1,
          "label": { "text": ["容差", "阈值", "Tolerance", "Threshold"] },
          "modes": ["field", "range", "slider"], "slider": { "x1": 0.35, "x2": 0.92 } }
      ] },
    { "id": "1.4a", "action": "SET_VALUE", "desc": "红蓝修正拉为 1", "value": 1, "min": 0, "max": 1,
      "label": { "text": ["红蓝修正", "Red/Blue", "Red Blue"] },
      "modes": ["field", "range", "slider"], "slider": { "x1": 0.35, "x2": 0.92 } },
    { "id": "1.4b", "action": "SET_VALUE", "desc": "Alpha 拉为 0", "value": 0, "min": 0, "max": 1,
      "label": { "text": ["Alpha", "透明度"], "exact": true },
      "modes": ["field", "range", "slider"], "slider": { "x1": 0.35, "x2": 0.92 } },
    { "id": "1.4c", "action": "MACRO", "name": "closePanel", "desc": "抠像完成" },

    { "id": "1.3", "action": "DRAG", "desc": "把角色拖到画面居中偏下",
      "from": { "x": "${previewX}", "y": "${previewY}" },
      "to": { "x": "${previewX}", "y": "${previewY} + ${characterOffsetY}" },
      "holdMs": 200, "durationMs": 600 },

    { "id": "1.5a", "action": "MACRO", "name": "addLayer", "desc": "添加 3D 摄影机",
      "args": { "item": ["3D摄影机", "3D 摄影机", "3D Camera"] } },
    { "id": "1.5b", "action": "MACRO", "name": "duplicate", "desc": "复制摄影机（第 2 个）",
      "args": { "name": ["3D摄影机", "3D 摄影机", "3D Camera"], "index": 0, "x": 0.3, "y": 0.72 } },
    { "id": "1.5c", "action": "MACRO", "name": "duplicate", "desc": "复制摄影机（第 3 个）",
      "args": { "name": ["3D摄影机", "3D 摄影机", "3D Camera"], "index": 0, "x": 0.3, "y": 0.72 } },

    { "id": "1.6", "action": "DRAG", "desc": "背景图拖入第 3 个摄影机（从左往右）",
      "from": { "text": ["木偶背景"], "x": 0.2, "y": 0.8 },
      "to": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 2, "x": 0.7, "y": 0.72 } },
    { "id": "1.7", "action": "DRAG", "desc": "抠好的角色拖入第 2 个摄影机",
      "from": { "text": ["木偶角色"], "x": 0.2, "y": 0.8 },
      "to": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 1, "x": 0.5, "y": 0.72 } },
    { "id": "1.8a", "action": "MACRO", "name": "duplicate", "desc": "复制第 2 个摄影机",
      "args": { "name": ["3D摄影机", "3D 摄影机", "3D Camera"], "index": 1, "x": 0.5, "y": 0.72 } },
    { "id": "1.8b", "action": "DRAG", "desc": "复制出的摄影机放入第 1 个摄影机",
      "from": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 2, "x": 0.7, "y": 0.72 },
      "to": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 0, "x": 0.3, "y": 0.72 } },
    { "id": "1.9a", "action": "CLICK", "desc": "点开第 1 个摄影机",
      "target": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 0, "x": 0.3, "y": 0.72 } },
    { "id": "1.9b", "action": "MACRO", "name": "duplicate", "desc": "把里面的摄影机再复制一份",
      "args": { "name": ["3D摄影机", "3D 摄影机", "3D Camera"], "index": -1, "x": 0.3, "y": 0.8 } },

    { "phase": "第二步：调色与打光", "id": "2.1a", "action": "MACRO", "name": "addEffect", "desc": "添加填充颜色",
      "args": { "keyword": "填充颜色", "item": ["填充颜色", "Fill Color", "Fill"] } },
    { "id": "2.1b", "action": "MACRO", "name": "setColor", "desc": "填充颜色选绿色",
      "args": { "label": ["颜色", "Color"], "hex": "${greenHex}" } },
    { "id": "2.1c", "action": "MACRO", "name": "closePanel", "desc": "填充颜色完成" },
    { "id": "2.2", "action": "DRAG", "desc": "移动绿色，露出侧面形成侧光",
      "from": { "x": "${previewX}", "y": "${previewY}" },
      "to": { "x": "${previewX} + ${lightSide} * ${fillShift} * 0.5", "y": "${previewY}" },
      "holdMs": 200, "durationMs": 700 },
    { "id": "2.3a", "action": "CLICK", "desc": "选中第 1 个摄影机",
      "target": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 0, "x": 0.3, "y": 0.72 } },
    { "id": "2.3b", "action": "MACRO", "name": "addEffect", "desc": "给第 1 个摄影机添加绿幕参数",
      "args": { "keyword": "绿幕", "item": ["绿幕抠像", "色度抠像", "Chroma Key"] } },
    { "id": "2.3c", "action": "MACRO", "name": "closePanel", "desc": "绿幕参数完成" },
    { "id": "2.4", "action": "MACRO", "name": "addEffect", "desc": "搜索「光」→ 灰光",
      "args": { "keyword": "光", "item": ["灰光", "Gray Light", "Grey Light"] } },
    { "id": "2.4b", "action": "MACRO", "name": "closePanel", "desc": "灰光完成" },
    { "id": "2.5a", "action": "MACRO", "name": "addEffect", "desc": "搜索「缩光」→ 柔光",
      "args": { "keyword": "缩光", "item": ["柔光", "Soft Light", "Soft Glow"] } },
    { "id": "2.5b", "action": "MACRO", "name": "setColor", "desc": "柔光颜色设为光源颜色",
      "args": { "label": ["颜色", "Color"], "hex": "${lightColorHex}" } },
    { "id": "2.5c", "action": "MACRO", "name": "closePanel", "desc": "柔光完成" },

    { "phase": "第三步：添加组与后期处理", "id": "3.1a", "action": "MACRO", "name": "addLayer", "desc": "添加组",
      "args": { "item": ["组", "Group"] } },
    { "id": "3.1b", "action": "DRAG", "desc": "第 1 个摄影机放进组",
      "from": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 0, "x": 0.3, "y": 0.72 },
      "to": { "text": ["组", "Group"], "exact": true, "x": 0.85, "y": 0.72 } },
    { "id": "3.1c", "action": "DRAG", "desc": "第 2 个摄影机放进组",
      "from": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 0, "x": 0.3, "y": 0.72 },
      "to": { "text": ["组", "Group"], "exact": true, "x": 0.85, "y": 0.72 } },
    { "id": "3.1d", "action": "DRAG", "desc": "第 3 个摄影机放进组",
      "from": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 0, "x": 0.3, "y": 0.72 },
      "to": { "text": ["组", "Group"], "exact": true, "x": 0.85, "y": 0.72 } },
    { "id": "3.1e", "action": "CLICK", "desc": "点开组",
      "target": { "text": ["组", "Group"], "exact": true, "x": 0.5, "y": 0.72 } },

    { "id": "3.2a", "action": "CLICK", "desc": "点第 2 个摄影机",
      "target": { "text": ["3D摄影机", "3D 摄影机", "3D Camera"], "sort": "x", "index": 1, "x": 0.5, "y": 0.72 } },
    { "id": "3.2b", "action": "MACRO", "name": "addEffect", "desc": "添加四色渐变",
      "args": { "keyword": "四色渐变", "item": ["四色渐变", "4-Color Gradient", "Four Color Gradient"] } },
    { "id": "3.2c", "action": "MACRO", "name": "setColor", "desc": "颜色一 = 光源颜色",
      "args": { "label": ["颜色一", "颜色 1", "颜色1", "Color 1"], "hex": "${lightColorHex}" } },
    { "id": "3.2d", "action": "MACRO", "name": "setColor", "desc": "颜色二 = 光源颜色",
      "args": { "label": ["颜色二", "颜色 2", "颜色2", "Color 2"], "hex": "${lightColorHex}" } },
    { "id": "3.2e", "action": "MACRO", "name": "setColor", "desc": "颜色三 = 黑色",
      "args": { "label": ["颜色三", "颜色 3", "颜色3", "Color 3"], "hex": "${blackHex}" } },
    { "id": "3.2f", "action": "MACRO", "name": "setColor", "desc": "颜色四 = 黑色",
      "args": { "label": ["颜色四", "颜色 4", "颜色4", "Color 4"], "hex": "${blackHex}" } },
    { "id": "3.2g", "action": "CLICK", "desc": "打开混合模式",
      "target": { "text": ["混合模式", "混合", "Blend Mode", "Blending"], "x": 0.5, "y": 0.8 } },
    { "id": "3.2h", "action": "CLICK", "desc": "选择正片叠底",
      "target": { "text": ["正片叠底", "Multiply"], "exact": true, "scroll": true, "x": 0.5, "y": 0.5 } },
    { "id": "3.2i", "action": "MACRO", "name": "closePanel", "desc": "四色渐变完成" },

    { "id": "3.3a", "action": "CLICK", "desc": "点组",
      "target": { "text": ["组", "Group"], "exact": true, "x": 0.5, "y": 0.72 } },
    { "id": "3.3b", "action": "MACRO", "name": "addEffect", "desc": "搜索「反转」",
      "args": { "keyword": "反转", "item": ["反转", "Invert"] } },
    { "id": "3.3c", "action": "MACRO", "name": "nvSeek", "desc": "定位到关键帧时间点",
      "args": { "seconds": "${keyframeTime}" } },
    { "id": "3.3d", "action": "MACRO", "name": "keyframeHere", "desc": "反转：打关键帧" },
    { "id": "3.3e", "action": "CLICK", "desc": "关键帧只开「与原始图像混合」",
      "target": { "text": ["与原始图像混合", "Blend with original", "Mix with original"], "x": 0.5, "y": 0.75 } },
    { "id": "3.4a", "action": "CLICK", "desc": "点该关键帧",
      "target": { "desc": ["关键帧", "Keyframe"], "index": -1, "x": 0.5, "y": "${nvTimelineY}" } },
    { "id": "3.4b", "action": "SET_VALUE", "desc": "「与原始图像混合」拉为 1", "value": 1, "min": 0, "max": 1,
      "label": { "text": ["与原始图像混合", "Blend with original", "Mix with original"] },
      "modes": ["field", "range", "dialog", "slider"], "slider": { "x1": 0.35, "x2": 0.92 } },
    { "id": "3.4c", "action": "MACRO", "name": "closePanel", "desc": "反转完成" },

    { "id": "3.5a", "action": "MACRO", "name": "addEffect", "desc": "搜索「基本矫正」", "enabledIf": "${saturationEnabled}",
      "args": { "keyword": "基本矫正", "item": ["基本矫正", "基本校正", "Basic Correction"] } },
    { "id": "3.5b", "action": "CLICK", "desc": "点饱和度并打开关键帧", "enabledIf": "${saturationEnabled}",
      "target": { "text": ["饱和度", "Saturation"], "exact": true, "x": 0.3, "y": 0.78 } },
    { "id": "3.5c", "action": "MACRO", "name": "nvSeek", "desc": "回到开头", "enabledIf": "${saturationEnabled}",
      "args": { "seconds": "0" } },
    { "id": "3.5d", "action": "MACRO", "name": "keyframeHere", "desc": "开头打关键帧", "enabledIf": "${saturationEnabled}" },
    { "id": "3.5e", "action": "SET_VALUE", "desc": "第一个关键帧饱和度 = 0", "enabledIf": "${saturationEnabled}",
      "value": 0, "min": 0, "max": 1, "label": { "text": ["饱和度", "Saturation"], "exact": true },
      "modes": ["field", "range", "dialog", "slider"], "slider": { "x1": 0.35, "x2": 0.92 } },
    { "id": "3.5f", "action": "MACRO", "name": "nvSeek", "desc": "定位到关键帧时间点", "enabledIf": "${saturationEnabled}",
      "args": { "seconds": "${keyframeTime}" } },
    { "id": "3.5g", "action": "MACRO", "name": "keyframeHere", "desc": "关键帧时间点打关键帧", "enabledIf": "${saturationEnabled}" },
    { "id": "3.5h", "action": "SET_VALUE", "desc": "第二个关键帧饱和度 = 0.5", "enabledIf": "${saturationEnabled}",
      "value": 0.5, "min": 0, "max": 1, "label": { "text": ["饱和度", "Saturation"], "exact": true },
      "modes": ["field", "range", "dialog", "slider"], "slider": { "x1": 0.35, "x2": 0.92 } },
    { "id": "3.5i", "action": "MACRO", "name": "closePanel", "desc": "基本矫正完成", "enabledIf": "${saturationEnabled}" },

    { "id": "3.6a", "action": "MACRO", "name": "addEffect", "desc": "搜索「摇晃」",
      "args": { "keyword": "摇晃", "item": ["摇晃", "Shake"] } },
    { "id": "3.6b", "action": "SET_VALUE", "desc": "摇晃强度 = ${shakeStrength}", "value": "${shakeStrength}", "min": 0, "max": 1,
      "label": { "text": ["强度", "幅度", "Strength", "Intensity", "Amount"] },
      "modes": ["field", "range", "dialog", "slider"], "slider": { "x1": 0.35, "x2": 0.92 } },
    { "id": "3.7a", "action": "CLICK", "desc": "点「截断」",
      "target": { "text": ["截断", "Truncate", "Clamp"], "x": 0.5, "y": 0.85 } },
    { "id": "3.7b", "action": "CLICK", "desc": "改成「镜像」",
      "target": { "text": ["镜像", "Mirror"], "exact": true, "x": 0.5, "y": 0.6 } },
    { "id": "3.7c", "action": "MACRO", "name": "closePanel", "desc": "摇晃完成" },

    { "id": "3.8a", "action": "CLICK", "desc": "点小房子旁边的导出符号",
      "target": { "desc": ["导出", "渲染", "Export", "Render"], "x": 0.2, "y": 0.05 } },
    { "id": "3.8b", "action": "CLICK", "desc": "点绿色三角形开始导出",
      "target": { "desc": ["开始", "开始导出", "Start", "Render", "导出"], "x": 0.5, "y": 0.9 } },
    { "id": "3.8c", "action": "WAIT_NEW_MEDIA", "desc": "等待 NV MAX 导出完成（相册/下载目录）",
      "timeoutMs": 1200000, "stableMs": 5000, "saveAs": "nvExportUri", "ensureInGallery": true },

    { "phase": "第四步：Motion Ninja 运镜", "id": "4.1", "action": "LAUNCH_APP", "desc": "打开 Motion Ninja",
      "package": "${motionNinjaPackage}", "waitMs": 3500 },
    { "id": "4.2a", "action": "CLICK", "desc": "点左下角加号（新建）",
      "target": { "text": ["新建", "新项目", "New Project", "+"], "desc": ["新建", "创建", "New", "Create", "Add"], "x": 0.1, "y": 0.93 } },
    { "id": "4.2b", "action": "CLICK", "desc": "切到视频分类", "optional": true, "retries": 0,
      "target": { "text": ["视频", "Video", "Videos"], "exact": true } },
    { "id": "4.2c", "action": "CLICK", "desc": "选择最新的视频（刚导出的）",
      "target": { "x": 0.17, "y": 0.2 } },
    { "id": "4.2d", "action": "CLICK", "desc": "确认导入", "optional": true, "retries": 1,
      "target": { "text": ["导入", "下一步", "确定", "完成", "Import", "Next", "Done"], "exact": true, "x": 0.88, "y": 0.93 } },
    { "id": "4.2e", "action": "CLICK", "desc": "确认画面比例", "optional": true, "retries": 0,
      "target": { "text": ["创建", "确定", "Create", "OK"], "exact": true } },

    { "id": "4.3a", "action": "TIMELINE_SEEK", "desc": "定位到反转色结束的时间点",
      "seconds": "${keyframeTime}", "area": { "y": "${mnTimelineY}", "x1": 0.15, "x2": 0.85 },
      "pxPerSecond": "${mnSecWidth}", "reset": true },
    { "id": "4.3b", "action": "CLICK", "desc": "点右上角标记加号",
      "target": { "text": ["标记", "Marker"], "desc": ["标记", "添加标记", "Marker", "Add marker"], "x": 0.92, "y": 0.58 } },

    { "id": "4.4a", "action": "CLICK", "desc": "点右下角关键帧",
      "target": { "text": ["关键帧", "Keyframe"], "desc": ["关键帧", "Keyframe"], "x": 0.9, "y": 0.93 } },
    { "id": "4.4b", "action": "TIMELINE_SEEK", "desc": "回到开头",
      "seconds": "0", "area": { "y": "${mnTimelineY}", "x1": 0.15, "x2": 0.85 }, "pxPerSecond": "${mnSecWidth}", "reset": true },
    { "id": "4.4c", "action": "CLICK", "desc": "开头打关键帧",
      "target": { "desc": ["添加关键帧", "Add keyframe", "关键帧"], "x": 0.5, "y": 0.6 } },
    { "id": "4.4d", "action": "TIMELINE_SEEK", "desc": "滑到标记位置",
      "seconds": "${keyframeTime}", "area": { "y": "${mnTimelineY}", "x1": 0.15, "x2": 0.85 },
      "pxPerSecond": "${mnSecWidth}", "reset": true },
    { "id": "4.4e", "action": "CLICK", "desc": "标记位置打关键帧",
      "target": { "desc": ["添加关键帧", "Add keyframe", "关键帧"], "x": 0.5, "y": 0.6 } },

    { "id": "4.5a", "action": "TIMELINE_SEEK", "desc": "滑到第一个关键帧",
      "seconds": "0", "area": { "y": "${mnTimelineY}", "x1": 0.15, "x2": 0.85 }, "pxPerSecond": "${mnSecWidth}", "reset": true },
    { "id": "4.5b", "action": "PINCH", "desc": "初始画面放大 ${pushZoom} 倍",
      "center": { "x": 0.5, "y": 0.3 }, "scale": "${pushZoom}", "span": 0.3, "durationMs": 700 },
    { "id": "4.5c", "action": "DRAG", "desc": "初始画面略微偏移（推镜起点）",
      "from": { "x": 0.5, "y": 0.3 }, "to": { "x": "0.5 + ${pushOffsetX}", "y": "0.3 + ${pushOffsetY}" },
      "holdMs": 150, "durationMs": 500 },

    { "id": "4.6a", "action": "CLICK", "desc": "导出",
      "target": { "text": ["导出", "Export"], "desc": ["导出", "Export"], "x": 0.9, "y": 0.05 } },
    { "id": "4.6b", "action": "CLICK", "desc": "保存到相册", "optional": true, "retries": 1,
      "target": { "text": ["保存", "导出", "保存到相册", "Save", "Export"], "exact": true, "x": 0.5, "y": 0.9 } },
    { "id": "4.6c", "action": "WAIT_NEW_MEDIA", "desc": "等待成品视频保存到相册",
      "timeoutMs": 1200000, "stableMs": 5000, "saveAs": "finalVideo", "ensureInGallery": true },
    { "id": "4.6d", "action": "NOTIFY", "desc": "通知：制作完成",
      "title": "一键木偶打光", "text": "制作完成！成品视频已保存到相册", "openUri": "${finalVideo}" }
  ]
}
