<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/recHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF6B6B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:textColor="#B8C0CC"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRecTap"
            style="@style/OverlayButton"
            android:text="📍坐标点击" />

        <Button
            android:id="@+id/btnRecDrag"
            style="@style/OverlayButton"
            android:text="↔ 拖动" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRecWait"
            style="@style/OverlayButton"
            android:text="+等待2秒" />

        <Button
            android:id="@+id/btnRecUndo"
            style="@style/OverlayButton"
            android:text="撤销" />

        <Button
            android:id="@+id/btnRecPause"
            style="@style/OverlayButton"
            android:text="暂停" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRecSave"
            style="@style/OverlayButton"
            android:background="@drawable/overlay_button_accent"
            android:text="保存脚本" />

        <Button
            android:id="@+id/btnRecCancel"
            style="@style/OverlayButton"
            android:text="放弃" />
    </LinearLayout>
</LinearLayout>
